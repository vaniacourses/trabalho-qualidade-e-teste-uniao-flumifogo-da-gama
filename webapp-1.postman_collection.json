  "item": [
    {
      "name": "Listar filmes",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// ==========================================\r",
              "// 1. VERIFICAÇÕES DE STATUS E PERFORMANCE\r",
              "// ==========================================\r",
              "pm.test(\"Status code é 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Tempo de resposta aceitável (< 800ms)\", function () {\r",
              "    // Ajuste este valor dependendo da exigência do seu projeto\r",
              "    pm.expect(pm.response.responseTime).to.be.below(800); \r",
              "});\r",
              "\r",
              "// ==========================================\r",
              "// 2. VERIFICAÇÕES DE ESTRUTURA (CONTRATO)\r",
              "// ==========================================\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"O corpo da resposta contém toda a estrutura de paginação esperada\", function () {\r",
              "    pm.expect(jsonData).to.be.an('object');\r",
              "    pm.expect(jsonData).to.have.property('content').that.is.an('array');\r",
              "    pm.expect(jsonData).to.have.property('last').that.is.a('boolean');\r",
              "    pm.expect(jsonData).to.have.property('totalElements').that.is.a('number');\r",
              "    pm.expect(jsonData).to.have.property('totalPages').that.is.a('number');\r",
              "    pm.expect(jsonData).to.have.property('size').that.is.a('number');\r",
              "    pm.expect(jsonData).to.have.property('number').that.is.a('number');\r",
              "    pm.expect(jsonData).to.have.property('first').that.is.a('boolean');\r",
              "    pm.expect(jsonData).to.have.property('numberOfElements').that.is.a('number');\r",
              "});\r",
              "\r",
              "pm.test(\"Se houver filmes no 'content', os atributos obrigatórios estão presentes\", function() {\r",
              "    if (jsonData.content.length > 0) {\r",
              "        let filmeAmostra = jsonData.content[0];\r",
              "        pm.expect(filmeAmostra).to.have.property('id').that.is.a('number');\r",
              "        pm.expect(filmeAmostra).to.have.property('name').that.is.a('string');\r",
              "        pm.expect(filmeAmostra).to.have.property('directors').that.is.a('string');\r",
              "        pm.expect(filmeAmostra).to.have.property('genders').that.is.an('array');\r",
              "    }\r",
              "});\r",
              "\r",
              "// ==========================================\r",
              "// 3. VERIFICAÇÕES DE LÓGICA E REGRAS DE NEGÓCIO\r",
              "// ==========================================\r",
              "pm.test(\"Integridade dos dados: o tamanho do 'content' corresponde ao 'numberOfElements'\", function () {\r",
              "    pm.expect(jsonData.content.length).to.eql(jsonData.numberOfElements);\r",
              "});\r",
              "\r",
              "pm.test(\"A página e o tamanho retornados refletem os parâmetros enviados na URL\", function () {\r",
              "    // Tenta capturar os parâmetros da URL. Se não existirem, assume os defaults prováveis do backend\r",
              "    let queryPage = pm.request.url.query.get(\"page\");\r",
              "    let querySize = pm.request.url.query.get(\"size\");\r",
              "    \r",
              "    let expectedPage = queryPage !== undefined ? parseInt(queryPage) : 0;\r",
              "    let expectedSize = querySize !== undefined ? parseInt(querySize) : 5;\r",
              "    \r",
              "    pm.expect(jsonData.number).to.eql(expectedPage, \"O número da página não confere com a URL.\");\r",
              "    pm.expect(jsonData.size).to.eql(expectedSize, \"O limite (size) não confere com a URL.\");\r",
              "});\r",
              "\r",
              "pm.test(\"Consistência das flags booleanas de navegação ('first' e 'last')\", function () {\r",
              "    // Validação da flag 'first'\r",
              "    if (jsonData.number === 0) {\r",
              "        pm.expect(jsonData.first, \"Deveria ser a primeira página (first = true)\").to.be.true;\r",
              "    } else {\r",
              "        pm.expect(jsonData.first, \"Não deveria ser a primeira página (first = false)\").to.be.false;\r",
              "    }\r",
              "\r",
              "    // Validação da flag 'last'\r",
              "    if (jsonData.totalPages > 0 && jsonData.number === (jsonData.totalPages - 1)) {\r",
              "        pm.expect(jsonData.last, \"Deveria ser a última página (last = true)\").to.be.true;\r",
              "    } else if (jsonData.totalPages > 0) {\r",
              "        pm.expect(jsonData.last, \"Não deveria ser a última página (last = false)\").to.be.false;\r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/api/peliculas?page=0&size=5",
          "protocol": "http",
          "host": [
